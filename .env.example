# ---------------------------------------------------------------------------
# AgentFlow AI — environment configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file.
#
# Only the first three variables are required. Everything else has a working
# default, so the template runs immediately after `npm run setup`.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agentflow?schema=public"

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Encrypts AI provider API keys stored in the database (AES-256-GCM).
# Generate with: openssl rand -base64 32
#
# Do NOT change this after users have saved provider keys — the stored keys
# become unreadable and everyone has to re-enter them.
ENCRYPTION_KEY=""


# === APPLICATION ===========================================================

# Your public URL. Webhook URLs, invitation links and password reset links
# are built from it, so it must be correct in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# === AI PROVIDERS ==========================================================
# Optional. These act as the server-wide fallback when a workspace has not
# saved its own key under Settings -> AI Providers. Leave blank to run in
# Demo Mode (simulated AI responses, no key required).
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# When true, and no provider key is configured, AI calls return realistic
# simulated responses and knowledge bases index with a local keyword
# embedder — so the whole product is explorable without any API key.
# Set to false in production once real keys are in place.
DEMO_MODE="true"

# Optional: point the OpenAI provider at any OpenAI-compatible gateway
# (Groq, Together, OpenRouter, LM Studio, vLLM, Ollama's OpenAI shim).
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# GEMINI_BASE_URL=""
# ANTHROPIC_BASE_URL=""


# === EMAIL =================================================================
# Which transport to use: console | smtp | resend | sendgrid
# "console" (the default) prints emails to the server log instead of sending
# them, so a fresh install works with nothing configured. Password resets and
# team invitations will NOT be delivered until you change this.
EMAIL_PROVIDER="console"
EMAIL_FROM="AgentFlow AI <noreply@example.com>"

# --- SMTP (covers Mailgun, Postmark, Amazon SES, Zoho, Gmail, ...) ---------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Resend (https://resend.com) -------------------------------------------
RESEND_API_KEY=""

# --- SendGrid --------------------------------------------------------------
SENDGRID_API_KEY=""


# === PAYMENTS ==============================================================
# Both gateways are fully implemented. Setting these keys is what switches
# paid plans on. You also need the per-plan price IDs, set in Admin -> Plans.
# See documentation/payments.md.

# --- Stripe (international) ------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Razorpay (India) ------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""


# === SCHEDULED AUTOMATIONS =================================================
# Protects /api/cron, which runs scheduled workflows. Anyone who can reach
# that URL can spend your users' AI budget, so set this in production.
# Generate with: openssl rand -base64 32
CRON_SECRET=""


# === SEED / DEMO ACCOUNTS ==================================================
# Used by `npm run db:seed`. Change these before deploying to production.
SEED_ADMIN_EMAIL="admin@agentflow.ai"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_USER_EMAIL="demo@agentflow.ai"
SEED_USER_PASSWORD="Demo@12345"
SEED_TEAMMATE_EMAIL="sam@agentflow.ai"
SEED_TEAMMATE_PASSWORD="Demo@12345"
